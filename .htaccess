# フォルダ一覧の表示を禁止
Options -Indexes

# 設定・ライブラリファイルへの直接アクセスを禁止
<FilesMatch "^((config|config\.sample|lib)\.php|\.ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

DirectoryIndex index.php
